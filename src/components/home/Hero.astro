---
// Hero.astro
---

<section class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20 items-center">
  <div class="lg:col-span-7 flex flex-col gap-6">

    <div class="inline-flex items-center gap-2 px-3 py-1 border border-primary/50 rounded bg-surface w-max">
      <span class="w-2 h-2 rounded-full bg-primary"></span>
      <span class="text-[13px] text-primary">disponible para nuevos proyectos</span>
    </div>

    <div class="min-h-[96px]">
      <p class="text-[14px] text-primary mb-2">&gt; identificación</p>
      <h1 id="title-container" class="font-display font-bold text-5xl tracking-tight leading-none mb-3 blink-cursor">
        <span id="typewriter" aria-hidden="true"></span>
        <span class="sr-only">Hola, soy Camilo</span>
      </h1>
      <p id="subtitle" class="font-display font-bold text-2xl md:text-3xl text-glitch-cyan opacity-0 transition-opacity duration-700 ease-in-out">QA Automation Engineer</p>
    </div>

    <ul class="flex flex-wrap gap-2 text-[12px] uppercase tracking-widest">
      <li class="border border-border-muted bg-surface px-3 py-1.5 rounded text-on-surface-variant">+ de 8 años de experiencia</li>
      <li class="border border-border-muted bg-surface px-3 py-1.5 rounded text-on-surface-variant">España · Remoto</li>
      <li class="border border-border-muted bg-surface px-3 py-1.5 rounded text-on-surface-variant">ES / EN</li>
      <li class="border border-border-muted bg-surface px-3 py-1.5 rounded text-on-surface-variant">E2E · API · CI/CD</li>
    </ul>

    <div class="bg-surface border border-border-muted rounded-lg overflow-hidden">
      <div class="flex items-center justify-between border-b border-border-muted px-4 py-2">
        <span class="text-[12px] uppercase tracking-widest text-on-surface-variant">bio.txt</span>
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-border-muted"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border-muted"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border-muted"></div>
        </div>
      </div>
      <p class="p-6 text-terminal-text text-[15px] leading-relaxed">
        &gt; QA Automation Engineer con +8 años de experiencia garantizando la calidad en entornos ágiles y CI/CD.<br><br>
        &gt; Construyo soluciones de testing robustas para E2E y API, manejando herramientas líderes como Playwright, Cypress, Karate DSL y Postman.<br><br>
        &gt; Mi valor diferencial es la integración de la IA en el ciclo de pruebas: optimizando recursos, acelerando entregas y asegurando que el software funcione sin sorpresas.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 mt-2">
      <a href="#" download class="!hidden items-center justify-center gap-2 bg-primary text-black font-bold text-[13px] uppercase tracking-widest py-4 px-8 rounded hover:bg-primary-dim transition-colors">
        <span class="material-symbols-outlined text-[18px]">download</span>
        Descargar CV
      </a>
      <a href="https://github.com/CamiloPosada19" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-primary/60 text-primary font-bold text-[13px] uppercase tracking-widest py-4 px-8 rounded hover:bg-primary/10 transition-colors">
        <span class="material-symbols-outlined text-[18px]">play_arrow</span>
        Ver proyectos
      </a>
    </div>
  </div>

  <div class="lg:col-span-5 relative flex justify-center lg:justify-end mt-8 lg:mt-0">
    <div id="id-photo" class="relative w-72 h-72 md:w-96 md:h-96">
      <div class="absolute inset-0 border border-primary/40 z-10 pointer-events-none rounded"></div>
      <div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-primary z-20"></div>
      <div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 border-primary z-20"></div>
      <div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 border-primary z-20"></div>
      <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-primary z-20"></div>
      <div class="absolute inset-0 overflow-hidden rounded">
        <!-- Puedes cambiar el src de la imagen aquí -->
        <img alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover portrait-gray" src="https://lh3.googleusercontent.com/aida/AEtjO1UOTUuwxKQOS2ixkupRg2kP4U33KM-fYT1SreF74sQmbOMSazjdLrpGIr_vxgW-vwoDl32k4j-l58NTWNENBVJD5_WZ0mIKD11y1xn-lUf0pn33-KJ-1Qc7Y6mM0cvLl4DjLW3Qv01wmeeI5BQMTGsebucLno-ktXyhaeYTjepmk_SD8idVurcofLejOo4DWGz9fPGAlMaC5xi57fi2uMUvXyvpDub3rmVHM9WsJBZFPMjucS0K2VpAXVyq">
        <img alt="Retrato de Camilo" class="absolute inset-0 w-full h-full object-cover portrait-color" src="https://lh3.googleusercontent.com/aida/AEtjO1UOTUuwxKQOS2ixkupRg2kP4U33KM-fYT1SreF74sQmbOMSazjdLrpGIr_vxgW-vwoDl32k4j-l58NTWNENBVJD5_WZ0mIKD11y1xn-lUf0pn33-KJ-1Qc7Y6mM0cvLl4DjLW3Qv01wmeeI5BQMTGsebucLno-ktXyhaeYTjepmk_SD8idVurcofLejOo4DWGz9fPGAlMaC5xi57fi2uMUvXyvpDub3rmVHM9WsJBZFPMjucS0K2VpAXVyq">
        <div class="scan-line"></div>
      </div>
      <div class="absolute bottom-2 right-2 bg-background/85 px-2 py-1 z-30 border border-primary/30 rounded">
        <span id="id-label" class="text-[10px] text-primary tracking-widest">SYS_OP: CAMILO_01</span>
      </div>
    </div>
  </div>
</section>

<script>
  function runPhotoScan() {
    const photo = document.getElementById('id-photo');
    const idLabel = document.getElementById('id-label');
    
    if (!photo || !idLabel) return;
    
    // Reset classes incase of view transition
    photo.classList.remove('scanning', 'scan-done');
    idLabel.textContent = 'SYS_OP: CAMILO_01';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSafeMode = document.documentElement.classList.contains('safe-mode');

    if (reduceMotion || isSafeMode) {
      photo.classList.add('scan-done');
      idLabel.textContent = 'SYS_OP: CAMILO_01 [OK]';
    } else {
      setTimeout(() => photo.classList.add('scanning'), 500);
      setTimeout(() => {
        photo.classList.add('scan-done');
        idLabel.textContent = 'SYS_OP: CAMILO_01 [OK]';
      }, 3100);
    }
  }

  function runTypewriter() {
    const textEl = document.getElementById('typewriter');
    const titleContainer = document.getElementById('title-container');
    const subtitle = document.getElementById('subtitle');
    if (!textEl || !subtitle || !titleContainer) return;

    const text = "Hola, soy Camilo";
    const isSafeMode = document.documentElement.classList.contains('safe-mode');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (isSafeMode || reduceMotion) {
      textEl.textContent = text;
      titleContainer.classList.remove('blink-cursor');
      subtitle.classList.remove('opacity-0');
      subtitle.classList.add('blink-cursor');
      return;
    }

    textEl.textContent = '';
    let i = 0;
    
    function typeChar() {
      if (i < text.length) {
        textEl.textContent += text.charAt(i);
        i++;
        // Variación aleatoria entre 30ms y 80ms para un ritmo natural y fluido
        const delay = Math.random() * 50 + 30;
        setTimeout(typeChar, delay);
      } else {
        setTimeout(() => {
          titleContainer.classList.remove('blink-cursor');
          subtitle.classList.remove('opacity-0');
          subtitle.classList.add('blink-cursor');
        }, 300);
      }
    }
    
    // Iniciar con un pequeño retardo para suavizar la carga
    setTimeout(typeChar, 150);
  }

  // Run on first load
  runPhotoScan();
  runTypewriter();

  // Run on safemode toggle to snap to finished state
  window.addEventListener('safemodechange', (e: any) => {
    const photo = document.getElementById('id-photo');
    const idLabel = document.getElementById('id-label');
    if (e.detail.active && photo && idLabel) {
       photo.classList.remove('scanning');
       photo.classList.add('scan-done');
       idLabel.textContent = 'SYS_OP: CAMILO_01 [OK]';
    }
    
    if (e.detail.active) {
       const textEl = document.getElementById('typewriter');
       const titleContainer = document.getElementById('title-container');
       const subtitle = document.getElementById('subtitle');
       if (textEl) textEl.textContent = "Hola, soy Camilo";
       if (titleContainer) titleContainer.classList.remove('blink-cursor');
       if (subtitle) {
         subtitle.classList.remove('opacity-0');
         subtitle.classList.add('blink-cursor');
       }
    }
  });
</script>
