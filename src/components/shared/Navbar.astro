---
const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 w-full z-50 bg-background/85 backdrop-blur-md border-b border-border-muted">
  <div class="flex justify-between items-center max-w-[1200px] mx-auto px-6 md:px-10 h-16">
    <a href="/portafolio" class="font-display font-bold text-lg tracking-tight">
      <span class="text-glitch-cyan">CAMILO</span><span class="text-on-surface-variant opacity-50">://</span><span class="text-primary">QA</span>
    </a>
    
    <div class="hidden md:flex items-center gap-8 text-[13px] uppercase tracking-widest">
      <a class={`hover:text-primary transition-colors ${currentPath === '/' || currentPath === '/portafolio' ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/portafolio">&gt; inicio</a>
      <a class={`hover:text-primary transition-colors ${currentPath.includes('/experiencia') ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/experiencia">&gt; experiencia</a>
      <a class={`hover:text-primary transition-colors ${currentPath.includes('/proyectos') ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/proyectos">&gt; proyectos</a>
      <a class="text-on-surface-variant hover:text-primary transition-colors" href="mailto:camilo@example.com">&gt; contacto</a>
    </div>
    
    <div class="flex items-center gap-3">
      <button id="safe-mode-toggle" aria-pressed="false" title="Desactiva todas las animaciones"
        class="!hidden text-[11px] uppercase tracking-widest border border-border-muted text-on-surface-variant px-3 py-1.5 rounded hover:border-primary hover:text-primary transition-colors">
        safe_mode: off
      </button>
      <a href="#" download class="!hidden md:inline-flex items-center gap-2 bg-primary text-black text-[12px] font-bold uppercase tracking-widest px-4 py-2 rounded hover:bg-primary-dim transition-colors">
        <span class="material-symbols-outlined text-[16px]">download</span> CV
      </a>
      <!-- Botón Hamburguesa Mobile -->
      <button id="mobile-menu-btn" class="md:hidden text-primary hover:text-primary-dim transition-colors flex items-center" aria-label="Toggle menu">
        <span class="material-symbols-outlined text-[28px]">menu</span>
      </button>
    </div>
  </div>

  <!-- Desplegable Mobile -->
  <div id="mobile-menu" class="absolute top-16 left-0 w-full md:hidden border-t border-border-muted bg-background/95 backdrop-blur-md px-6 py-6 flex flex-col gap-6 text-[14px] uppercase tracking-widest shadow-2xl transition-all duration-300 ease-out opacity-0 pointer-events-none -translate-y-4">
    <a class={`block hover:text-primary transition-colors ${currentPath === '/' || currentPath === '/portafolio' ? 'text-primary' : 'text-on-surface-variant'}`} href="/portafolio">&gt; inicio</a>
    <a class={`block hover:text-primary transition-colors ${currentPath.includes('/experiencia') ? 'text-primary' : 'text-on-surface-variant'}`} href="/experiencia">&gt; experiencia</a>
    <a class={`block hover:text-primary transition-colors ${currentPath.includes('/proyectos') ? 'text-primary' : 'text-on-surface-variant'}`} href="/proyectos">&gt; proyectos</a>
    <a class="block text-on-surface-variant hover:text-primary transition-colors" href="mailto:camilo@example.com">&gt; contacto</a>
  </div>
</nav>

<script>
  // Safe mode toggle logic
  const toggle = document.getElementById('safe-mode-toggle');
  
  // Lógica menú móvil
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconSpan = mobileMenuBtn?.querySelector('.material-symbols-outlined');

  if (mobileMenuBtn && mobileMenu && iconSpan) {
    let lastScrollY = window.scrollY;

    const closeMenu = () => {
      mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
      iconSpan.textContent = 'menu';
    };

    const openMenu = () => {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
      mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      iconSpan.textContent = 'close';
      lastScrollY = window.scrollY; // Resetear scroll base al abrir
    };

    mobileMenuBtn.addEventListener('click', () => {
      if (mobileMenu.classList.contains('opacity-0')) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Cerrar suavemente al hacer scroll (con margen de tolerancia de 50px)
    window.addEventListener('scroll', () => {
      if (!mobileMenu.classList.contains('opacity-0')) {
        if (Math.abs(window.scrollY - lastScrollY) > 50) {
          closeMenu();
        }
      } else {
        lastScrollY = window.scrollY;
      }
    }, { passive: true });

    // Cerrar al hacer clic en cualquier enlace del menú
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (toggle) {
    // Inicializar estado basado en localStorage
    const isSafeMode = document.documentElement.classList.contains('safe-mode');
    toggle.textContent = isSafeMode ? 'safe_mode: on' : 'safe_mode: off';
    toggle.setAttribute('aria-pressed', isSafeMode.toString());

    toggle.addEventListener('click', () => {
      const active = document.documentElement.classList.toggle('safe-mode');
      toggle.textContent = active ? 'safe_mode: on' : 'safe_mode: off';
      toggle.setAttribute('aria-pressed', active.toString());
      
      // Guardar preferencia
      localStorage.setItem('safeMode', active.toString());
      
      // Disparar evento para componentes que dependan del modo seguro
      const event = new CustomEvent('safemodechange', { detail: { active } });
      window.dispatchEvent(event);
    });
  }
</script>
