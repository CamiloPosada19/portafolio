---
const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 w-full z-50 bg-background/85 backdrop-blur-md border-b border-border-muted">
  <div class="flex justify-between items-center max-w-[1200px] mx-auto px-6 md:px-10 h-16">
    <a href="/" class="font-display font-bold text-lg tracking-tight">
      <span class="text-glitch-cyan">CAMILO</span><span class="text-on-surface-variant opacity-50">://</span><span class="text-primary">QA</span>
    </a>
    
    <div class="hidden md:flex items-center gap-8 text-[13px] uppercase tracking-widest">
      <a class={`hover:text-primary transition-colors ${currentPath === '/' ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/">&gt; inicio</a>
      <a class={`hover:text-primary transition-colors ${currentPath.includes('/experiencia') ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/experiencia">&gt; experiencia</a>
      <a class={`hover:text-primary transition-colors ${currentPath.includes('/proyectos') ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant'}`} href="/proyectos">&gt; proyectos</a>
      <a class="text-on-surface-variant hover:text-primary transition-colors" href="mailto:camilo@example.com">&gt; contacto</a>
    </div>
    
    <div class="flex items-center gap-3">
      <button id="safe-mode-toggle" aria-pressed="false" title="Desactiva todas las animaciones"
        class="!hidden text-[11px] uppercase tracking-widest border border-border-muted text-on-surface-variant px-3 py-1.5 rounded hover:border-primary hover:text-primary transition-colors">
        safe_mode: off
      </button>
      <a href="#" download class="!hidden md:inline-flex items-center gap-2 bg-primary text-black text-[12px] font-bold uppercase tracking-widest px-4 py-2 rounded hover:bg-primary-dim transition-colors">
        <span class="material-symbols-outlined text-[16px]">download</span> CV
      </a>
    </div>
  </div>
</nav>

<script>
  // Safe mode toggle logic
  const toggle = document.getElementById('safe-mode-toggle');
  
  if (toggle) {
    // Inicializar estado basado en localStorage
    const isSafeMode = document.documentElement.classList.contains('safe-mode');
    toggle.textContent = isSafeMode ? 'safe_mode: on' : 'safe_mode: off';
    toggle.setAttribute('aria-pressed', isSafeMode.toString());

    toggle.addEventListener('click', () => {
      const active = document.documentElement.classList.toggle('safe-mode');
      toggle.textContent = active ? 'safe_mode: on' : 'safe_mode: off';
      toggle.setAttribute('aria-pressed', active.toString());
      
      // Guardar preferencia
      localStorage.setItem('safeMode', active.toString());
      
      // Disparar evento para componentes que dependan del modo seguro
      const event = new CustomEvent('safemodechange', { detail: { active } });
      window.dispatchEvent(event);
    });
  }
</script>
