---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border-muted py-8 px-6 md:px-10 bg-[#0e0e0f]">
  <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-primary"></span>
      <span class="text-[13px] text-on-surface-variant">Todos los sistemas operativos</span>
    </div>
    <div class="flex gap-6 text-[12px] uppercase tracking-widest">
      <a data-track="Contact Click" data-track-props='{"location": "footer"}' class="text-on-surface-variant hover:text-primary transition-colors" href="mailto:camilo.posada.acosta@gmail.com">email</a>
      <a data-track="Social Click" data-track-props='{"network": "github", "location": "footer"}' class="text-on-surface-variant hover:text-primary transition-colors" href="https://github.com/CamiloPosada19" target="_blank" rel="noopener noreferrer">github</a>
      <a data-track="Social Click" data-track-props='{"network": "linkedin", "location": "footer"}' class="text-on-surface-variant hover:text-primary transition-colors" href="https://www.linkedin.com/in/camiloposadaacosta" target="_blank" rel="noopener noreferrer">linkedin</a>
    </div>
    <div class="text-[11px] text-on-surface-variant/60">© {currentYear} Camilo — QA Automation</div>
  </div>
</footer>
